# --- Vite (browser-safe). Copy this file to .env and replace placeholders. ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-public-key
# Optional alias (same value as VITE_SUPABASE_KEY):
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Python sync: npm run sync:nba (server-side only; never VITE_ prefix). ---
# Same URL as above is fine; omit SUPABASE_URL if you already set VITE_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=paste-service-role-jwt-from-dashboard-api-settings
